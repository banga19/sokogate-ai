# ============================================
# SOKOGATE AI - Environment Configuration
# Copy this file to .env and fill in the values
# ============================================

# ----------------------
# Database
# ----------------------
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
# Optional: Separate products database
PRODUCTS_DATABASE_URL=

# ----------------------
# Authentication (@auth/core)
# ----------------------
AUTH_SECRET=your-very-long-random-secret-minimum-32-bytes-change-this-in-production
AUTH_URL=http://localhost:3000
# Admin emails (comma-separated) - these users can access admin endpoints
ADMIN_EMAILS=admin@example.com,you@yourcompany.com

# ----------------------
# Firebase (Client-side)
# ----------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----------------------
# AI & External APIs
# ----------------------
ANTHROPIC_API_KEY=sk-ant-
# Optional: OpenAI (fallback)
OPENAI_API_KEY=

# ----------------------
# File Storage
# ----------------------
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=

# ----------------------
# Anything AI Integration
# ----------------------
ANYTHING_PROJECT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------
# Sales & Funding Assets
# Path to CSV files for automated imports (optional)
# ----------------------
ASSETS_BASE_PATH=/home/apop/sales-and-funding-assets
# Alternative name for backwards compatibility:
SALES_ASSETS_PATH=

# ----------------------
# Business Settings (optional defaults)
# ----------------------
BUSINESS_NAME=Sokogate
PRIMARY_COLOR=#1E3A8A
SECONDARY_COLOR=#EF4444

# ----------------------
# Environment
# ----------------------
NODE_ENV=development
#PORT=4000

# ----------------------
# Optional: Monitoring
# ----------------------
# SENTRY_DSN=
# LOGFLOW_API_KEY=
