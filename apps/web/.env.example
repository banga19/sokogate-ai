# Firebase Configuration (for authentication)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Server Configuration
PORT=3000
NODE_ENV=production
AUTH_SECRET=your-auth-secret-change-this-in-production

# Auth URL (your public app URL, used for secure cookie validation)
# For local dev: AUTH_URL=http://localhost:4000
# For production: AUTH_URL=https://yourdomain.com
AUTH_URL=http://localhost:4000

# Main Application Database (for leads, business settings, auth)
DATABASE_URL=postgresql://sokogate_user:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/sokogate_db?sslmode=require

# Optional: Google OAuth (uncomment to enable)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: Facebook OAuth (uncomment to enable)
# FACEBOOK_CLIENT_ID=your-facebook-app-id
# FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Optional: Twitter/X OAuth (uncomment to enable)
# TWITTER_CLIENT_ID=your-twitter-client-id
# TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Optional: Apple Sign In (uncomment to enable)
# APPLE_CLIENT_ID=your-apple-service-id
# APPLE_CLIENT_SECRET=your-apple-private-key
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id

# Optional: Microsoft OAuth (uncomment to enable)
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Optional: GitHub OAuth (uncomment to enable)
# GITHUB_ID=your-github-client-id
# GITHUB_SECRET=your-github-client-secret

# Optional: Discord OAuth (uncomment to enable)
# DISCORD_CLIENT_ID=your-discord-client-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret
