# Server Configuration
PORT=3000
NODE_ENV=production
AUTH_SECRET=your-auth-secret-here

# Main Application Database (for leads, business settings)
# This should point to your Neon/postgres database
DATABASE_URL=postgresql://sokogate_user:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/sokogate_db?sslmode=require

# Optional: Separate Products Database (if products live on a different DB)
# If not set, defaults to DATABASE_URL (same database)
PRODUCTS_DATABASE_URL=postgresql://sokogate_user:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/sokogate_db?sslmode=require

# Create.xyz Integration (optional)
NEXT_PUBLIC_CREATE_BASE_URL=https://www.create.xyz
NEXT_PUBLIC_CREATE_HOST=your-domain.com
NEXT_PUBLIC_CREATE_PROJECT_GROUP_ID=your-project-group-id

# CORS (optional, comma-separated origins)
CORS_ORIGINS=https://yourdomain.com

# App URL
NEXT_PUBLIC_APP_URL=https://yourdomain.com
