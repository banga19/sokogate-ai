# Multi-stage Dockerfile for Sokogate AI Web App
# Stage 1: Build
# Stage 2: Production runtime

# ============================================
# STAGE 1: Build
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY apps/web/package*.json ./
COPY apps/web/tsconfig*.json ./
COPY apps/web/vite.config.ts ./
COPY apps/web/react-router.config.ts ./
COPY apps/web/tailwind.config.js ./
COPY apps/web/postcss.config.js ./

# Install dependencies
RUN npm ci

# Copy source code
COPY apps/web/src ./src
COPY apps/web/public ./public
COPY apps/web/__create ./__create
COPY apps/web/sql ./sql
COPY apps/web/scripts ./scripts

# Build application
RUN npm run build

# ============================================
# STAGE 2: Production Runtime
# ============================================
FROM node:20-alpine AS production

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create app directory
WORKDIR /app

# Copy package files
COPY apps/web/package*.json ./
COPY apps/web/prisma ./prisma  # if using prisma

# Install production dependencies only
RUN npm ci --only=production && npm cache clean --force

# Copy built application from builder
COPY --from=builder /app/build ./build
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma  # if using prisma

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nodejs -u 1001
USER nodejs

# Expose port
EXPOSE 4000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4000/api/health', (r) => { if (r.statusCode !== 200) throw new Error('Not healthy'); })" || exit 1

# Start application
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "build/server/index.js"]
